<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.developer.healthkit</key>
    <true/>
    <!-- iCloud/CloudKit entitlements removed: personal (free) development
         teams cannot sign the iCloud capability, so device builds fail with
         them present. The app detects the missing capability at launch and
         runs on the local store. To re-enable after joining the paid
         Developer Program, restore:
         com.apple.developer.icloud-services = [CloudKit]
         com.apple.developer.icloud-container-identifiers =
             [iCloud.com.liammelkersson.BoulderTracker]
         (see docs/cloudkit-backup.md) -->
</dict>
</plist>
